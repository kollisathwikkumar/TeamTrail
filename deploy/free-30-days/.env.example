# Copy to .env on the server, chmod 600, and replace all CHANGE_ME values.
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARS
TEAMTRAIL_MCP_TOKEN=CHANGE_ME_64_HEX_CHARS
BRAIN_GROUP_ID=teamtrail_workspace

# Auth0 SPA/API settings: set the same tenant/domain, client id, and API audience.
# Add this URL as an Allowed Callback / Logout / Web Origin in Auth0.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://teamtrail.example.com/mcp
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://teamtrail.example.com/mcp

# Optional stable Cloudflare Tunnel profile; leave empty to use quick-tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional integrations. Nango free plan currently includes a small monthly allowance.
NANGO_API_KEY=

# Optional model API keys. These are separate from infrastructure hosting credits.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TEAMTRAIL_BOOTSTRAP_SUBJECT=auth0|replace-with-owner-sub
TEAMTRAIL_MCP_RESOURCE_URL=https://teamtrail.example.com/mcp
