# Database (required)
DATABASE_URL=postgresql://brain:brain@localhost:5432/company_brain

# Embeddings (required for semantic search)
OPENAI_API_KEY=sk-...

# LLM extraction / triage / answer synthesis
# OPENAI_API_KEY is used by default. Anthropic is optional as an explicit fallback.
# Without an LLM key, semantic extraction and triage fail closed instead of using
# brittle semantic regex fallbacks.
# Optional: set COMPANY_BRAIN_LLM_TIMEOUT_MS only if you want to fail slow LLM calls.
ANTHROPIC_API_KEY=sk-ant-...

# Optional provider OAuth/sync bridge for Google Drive, Slack, GitHub, etc.
NANGO_API_KEY=

# Local-only fallback auth. Production REST requires Auth0 domain, client, and audience below.
BRAIN_AUTH_TOKEN=your-secret-token

# Comma-separated browser origins for split frontend/API deployments.
# Same-origin requests are allowed automatically; do not use * for a private workspace.
BRAIN_CORS_ORIGINS=http://localhost:4180

# Remote Streamable HTTP MCP access for hosted agents. Set a unique long random value.
TEAMTRAIL_MCP_TOKEN=

# Server config
BRAIN_REST_PORT=3333
BRAIN_REST_HOST=127.0.0.1
BRAIN_GROUP_ID=default

# Auth0 OIDC (public identifiers; set matching values on the API and web build)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://teamtrail.example.com/mcp
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://teamtrail.example.com/mcp
# Initial workspace owner: exact Auth0 `sub` for the first administrator
TEAMTRAIL_BOOTSTRAP_SUBJECT=auth0|replace-with-owner-sub
TEAMTRAIL_MCP_RESOURCE_URL=https://teamtrail.example.com/mcp
