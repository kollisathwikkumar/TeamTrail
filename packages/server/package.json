{
  "name": "@company-brain/server",
  "version": "0.1.5",
  "description": "MCP + REST server for Company Brain",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "company-brain": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:rest": "node dist/index.js --rest",
    "start:mcp": "node dist/index.js --mcp",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company-brain/core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jose": "^6.2.12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
